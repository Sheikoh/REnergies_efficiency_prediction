   "id": "d10c8ef6",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_std(x, table):\n",
    "   if x <= min(table['min']):\n",
    "      std = table['std'][0]\n",
    "   elif x > max(table['max']):\n",
    "      std = table['std'].iloc[-1]\n",
    "   else:\n",
    "      std = table[(x > table['min']) & (x <= table['max'])]['std']\n",
    "   return std\n"
   ]
  },
